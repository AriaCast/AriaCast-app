    <string name="sendspin_connected_unpaired">%1$s உடன் இணைந்தது (இணைக்கப்படவில்லை)</string>
    <string name="sendspin_source_streaming">இந்தச் சாதனத்தின் ஒலியை %1$s க்கு அனுப்புகிறது</string>
    <string name="sendspin_pair">Music Assistant உடன் இணை</string>
    <string name="sendspin_pair_row_desc">Music Assistant-இல் உள்ளிட அல்லது ஸ்கேன் செய்ய டோக்கன்</string>
    <string name="sendspin_pair_desc">Music Assistant-இல் இந்தச் சாதனத்தைச் சேர்த்து, இந்த இணைப்பு டோக்கனை உள்ளிடவும் அல்லது ஸ்கேன் செய்யவும். இந்தச் சாதனத்தின் ஒலியை நேரடி உள்ளீடாகப் பயன்படுத்த இணைத்தல் தேவை.</string>
    <string name="sendspin_pair_secret">இதை ரகசியமாக வைக்கவும்: இந்த டோக்கன் உள்ள எவரும் இந்தச் சாதனத்துடன் இணையலாம்.</string>
    <string name="sendspin_copied">டோக்கன் நகலெடுக்கப்பட்டது</string>
    <string name="sendspin_unpaired">இணைக்காத சர்வர்களை அனுமதி</string>
    <string name="sendspin_unpaired_desc">சர்வர்கள் இணைக்காமலே இயக்கலாம் (குறைந்த பாதுகாப்பு)</string>
    <string name="sendspin_paired_servers">இணைத்த சர்வர்கள்</string>
    <string name="sendspin_forget">மறந்துவிடு</string>
