    <string name="sendspin_inactive_desc">நேரடி உள்ளீட்டை, அல்லது பெறு கீழ் Music Assistant-ஐ இயக்கவும்</string>
    <string name="sendspin_live_input">நேரடி உள்ளீடு</string>
