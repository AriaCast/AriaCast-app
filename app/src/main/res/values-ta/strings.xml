    <string name="ma_needs_auth">பிளேயரைத் தேர்ந்தெடுக்க Music Assistant-இல் உள்நுழையவும்.</string>
    <string name="ma_sign_in">உள்நுழை</string>
    <string name="ma_account">Music Assistant கணக்கு</string>
    <string name="ma_or_token">அல்லது நீண்டகால டோக்கனை ஒட்டவும்:</string>
    <string name="ma_token">டோக்கன்</string>
    <string name="ma_unreachable">Music Assistant பதிலளிக்கவில்லை (%1$s).</string>
    <string name="doctor_title">இணைப்புச் சோதனை</string>
    <string name="doctor_desc">இந்தச் சாதனத்திலிருந்து ஸ்பீக்கர் வரை ஒவ்வொரு படியையும் சோதித்து எது தோல்வி எனக் காட்டும்.</string>
    <string name="doctor_network">நெட்வொர்க்</string>
    <string name="doctor_network_ok">Wi-Fi அல்லது Ethernet உடன் இணைந்தது.</string>
    <string name="doctor_network_fail">உள்ளூர் நெட்வொர்க் இல்லை: மொபைல் டேட்டாவில் ஸ்பீக்கர்களை அடைய முடியாது.</string>
    <string name="doctor_notifications">பாடல் தகவல்</string>
    <string name="doctor_notifications_ok">அறிவிப்பு அணுகல் இயக்கத்தில் உள்ளது.</string>
    <string name="doctor_notifications_warn">அறிவிப்பு அணுகல் இல்லாமல் ஒலிப்பதை ஸ்பீக்கர்கள் காட்டாது.</string>
    <string name="doctor_speakers">ஸ்பீக்கர்கள்</string>
    <string name="doctor_speakers_ok">%1$d கிடைத்தன.</string>
    <string name="doctor_speakers_warn">எதுவும் கிடைக்கவில்லை. வேறு VLAN? ஸ்பீக்கரை முகவரி மூலம் சேர்க்கவும்.</string>
    <string name="doctor_speakers_protocols_off">எதுவும் கிடைக்கவில்லை. AriaCast மட்டுமே இயக்கத்தில்: நெறிமுறைகளில் AirPlay, Google Cast, DLNA அல்லது Snapcast-ஐ இயக்கவும்.</string>
    <string name="doctor_casting">அனுப்புதல்</string>
    <string name="doctor_casting_idle">மீதமுள்ள சோதனைகளுக்கு அனுப்பத் தொடங்கவும்.</string>
    <string name="doctor_source">ஒலிச் சமிக்ஞை</string>
    <string name="doctor_source_ok">உண்மையான ஒலி பிடிக்கப்படுகிறது.</string>
    <string name="doctor_source_silent">இதுவரை அமைதி மட்டுமே. ஏதாவது ஒலிக்கிறதா?</string>
    <string name="doctor_source_blocked">ஏதோ ஒலிக்கிறது, ஆனால் பிடிப்பு அமைதியாக உள்ளது: அந்த ஆப் ஒலிப் பிடிப்பைத் தடுக்கிறது. AriaCompanion அதை அனுப்ப முடியும்.</string>
    <string name="doctor_reach">%1$s-ஐ அடை</string>
    <string name="doctor_reach_ok">%1$s:%2$d பதிலளிக்கிறது.</string>
    <string name="doctor_reach_fail">%1$s:%2$d பதிலளிக்கவில்லை. ஃபயர்வால், VLAN அல்லது தவறான போர்ட்?</string>
    <string name="doctor_flow">தரவு ஓட்டம்</string>
    <string name="doctor_flow_detail">அனுப்பியது %1$d · பெற்றது %2$d · இழந்தது %3$d</string>
    <string name="doctor_companion">ஃபர்ம்வேர் %1$s, %2$d தடைகள்.</string>
    <string name="doctor_copy">அறிக்கையை நகலெடு</string>
    <string name="doctor_copied">அறிக்கை நகலெடுக்கப்பட்டது</string>
    <string name="onb_welcome_title">எந்த ஒலியையும் எங்கும் அனுப்பு</string>
    <string name="onb_welcome_body">AriaCast இந்தச் சாதனத்தின் ஒலியை AirPlay, Google Cast, DLNA, Snapcast, Sendspin ஸ்பீக்கர்களுக்கு அனுப்பும்; இந்தச் சாதனத்தையே ஸ்பீக்கராகவும் மாற்றும்.</string>
    <string name="onb_permissions_title">சில அனுமதிகள்</string>
    <string name="onb_permissions_body">பிற ஆப்ஸின் ஒலியைப் பிடிக்க Android அனுமதிக்கும் வழி ஒலிப் பதிவு. அறிவிப்புகள் அனுப்பும் நிலையைக் காட்டும். அறிவிப்பு அணுகல் ஸ்பீக்கர்கள் பாடலைக் காட்டவும் இயக்கத்தைக் கட்டுப்படுத்தவும் உதவும்.</string>
    <string name="onb_allow_notifications">அறிவிப்பு அணுகலை அனுமதி</string>
    <string name="onb_notifications_done">அறிவிப்பு அணுகல் இயக்கத்தில் உள்ளது.</string>
    <string name="onb_role_title">இந்தச் சாதனம் எதற்கு?</string>
    <string name="onb_role_body">இதை எப்போது வேண்டுமானாலும் மாற்றலாம்.</string>
    <string name="onb_role_send">அனுப்பு</string>
    <string name="onb_role_send_desc">இந்தச் சாதனத்தின் ஒலியை ஸ்பீக்கர்களில் இயக்கு.</string>
    <string name="onb_role_receive">பெறு</string>
    <string name="onb_role_receive_desc">இந்தச் சாதனத்தை மற்றவர்களுக்கு ஸ்பீக்கராகப் பயன்படுத்து.</string>
    <string name="onb_role_both">இரண்டும்</string>
    <string name="onb_role_both_desc">ஒரே நேரத்தில் பெறவும் அனுப்பவும்.</string>
    <string name="onb_done_title">எல்லாம் தயார்</string>
    <string name="onb_done_body">இந்த நெட்வொர்க்கில் %1$d ஸ்பீக்கர்கள் கிடைத்தன.</string>
    <string name="onb_done_body_none">இன்னும் ஸ்பீக்கர்கள் இல்லை; AriaCast தொடர்ந்து தேடுகிறது.</string>
