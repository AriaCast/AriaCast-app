<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp): brand color with the app icon centered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="45" android:startColor="#3E001D" android:endColor="#B90063" />
        </shape>
    </item>
    <item android:width="140dp" android:height="140dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
