# Classic Bluetooth only (A2DP sink + SPP), Bluedroid host.
CONFIG_IDF_TARGET="esp32"
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_HFP_ENABLE=n
# Hand A2DP frames to the application undecoded (forwarded to the app as SBC).
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
# Two links at once: the phone's A2DP and SPP share one ACL, but leave room.
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# The Bluetooth stack alone fills most of 1 MB: use the 1.5 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
